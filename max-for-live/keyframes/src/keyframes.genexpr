// Keyframes - gen~ core. Build 9.
//
// A port of the Mutable Instruments Frames firmware (keyframer.cc, poly_lfo.cc,
// frames.cc), Copyright 2013 Emilie Gillet, released under the MIT license.
// See LICENSE-frames.txt next to this file.
//
// Keyframes live in the buffer~ "frkf" so the patch can save them with the Live
// set: [0] = keyframe count, [1] = id counter, then 6 values per keyframe:
// timestamp (0..65535), id, and four levels (0..65535).
//
// This file is also run by tests/test_core.js, so it sticks to a subset of
// GenExpr that is valid JavaScript once the declarations are stripped: every
// variable is assigned before it is read, and a History is read only at the
// top of the sample and written only at the bottom.

// One point of a Poly LFO wavetable before it is normalised. Tables 12
// (stepped triangle) and 16 (random) are built in the main code.
rawwave(w_w, w_i) {
	w_t = w_i / 256;
	w_tri = 2 * w_t;
	if (w_t >= 0.5) {
		w_tri = 2 - 2 * w_t;
	}
	w_sin = sin(2 * pi * w_t);
	w_rev = (255 - w_i) / 256;
	w_v = 0;
	w_j = 0;
	w_f = 0;
	if (w_w == 0) {
		w_v = w_t * w_t * w_t * w_t;
	} else if (w_w == 1) {
		w_v = w_t;
	} else if (w_w == 2) {
		w_v = w_tri;
	} else if (w_w == 3) {
		w_v = w_rev;
	} else if (w_w == 4) {
		w_v = w_rev * w_rev * w_rev * w_rev;
	} else if (w_w == 5) {
		w_v = max(w_sin, 0) * (1 - cos(4 * pi * w_t)) * 0.5;
	} else if (w_w == 6) {
		if (w_t < 0.5) {
			w_v = 1;
		}
	} else if (w_w == 7) {
		w_v = w_sin * w_sin * w_sin;
	} else if (w_w == 8) {
		w_v = w_sin;
	} else if (w_w == 9) {
		w_v = w_sin + 0.7 * sin(4 * pi * w_t);
	} else if (w_w == 10) {
		w_v = w_sin + 0.7 * sin(6 * pi * w_t);
	} else if (w_w == 11) {
		w_v = w_sin + 0.7 * sin(10 * pi * w_t);
	} else if (w_w == 13 || w_w == 14) {
		w_j = w_i + 128;
		if (w_j >= 256) {
			w_j = w_j - 256;
		}
		w_f = 2 * w_j / 256;
		if (w_j >= 128) {
			w_f = 2 - 2 * w_j / 256;
		}
		w_f = 2 * w_f - 1;
		if (w_w == 13) {
			w_f = 2 * w_f;
		} else {
			w_f = 1.5 * w_f;
		}
		if (w_f > 1) {
			w_f = 2 - w_f;
		}
		if (w_f < -1) {
			w_f = -2 - w_f;
		}
		w_v = 0 - w_f;
	} else if (w_w == 15) {
		w_v = pow(2, 4 * w_tri) - 1;
	} else if (w_w == 17) {
		w_v = w_sin;
	}
	return w_v;
}

Buffer frkf("frkf");
Data wt(4626);
Data pal(24);
Data rbw(51);
Data cvs(4);
Data rsp(4);
Data lvl(4);
Data lph(4);
Data lval(4);
Data lsn(4);
Data gsm(4);

Param pframe(0, min=0, max=100);
Param plv1(0, min=0, max=100);
